{
	default_bind 127.0.0.1
	log {
		level error
		format console
	}
}
gist.github.com {
	tls /nix/store/mgc9s9w34gjf8c2d1g5bnq376xqs0hj4-server.crt /nix/store/jzcs400vs7vz0iga8iqv2b4rb1hip7cy-server.key
	@has_range {
		header Range *
	}
	@has_if_range {
		header If-Range *
	}

	reverse_proxy {
		dynamic multi {
			a gist.github.com 443 {
				resolvers 127.0.0.1:5365
				refresh 10s
			}
			a gist.github.com 443 {
				resolvers 127.0.0.1:5370
				refresh 10s
			}
		}

		header_up Host {http.request.host}
		max_fails 2
		fail_duration 10s
		unhealthy_status 500 502 503 504
		unhealthy_latency 1s
		lb_policy ip_hash
		header_up @has_range Range {http.request.header.Range}
		header_up @has_if_range If-Range {http.request.header.If-Range}
		header_up User-Agent {http.request.header.User-Agent}
		header_up X-Real-IP {http.request.remote.host}

		transport http {
			tls_insecure_skip_verify
			tls_server_name ""
		}
	}
}

