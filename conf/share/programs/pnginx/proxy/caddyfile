{
	default_bind 127.0.0.1
	auto_https off
}
gist.github.com {
	encode zstd
	tls /nix/store/gvanqpszzmndvji9fqcmjrzjdkj32xgq-server.crt /nix/store/7mcy5xlvhifppa82gamhc9sn0wiw4g3m-server.key
	reverse_proxy {
		dynamic multi {
			a gist.github.com 443 {
				resolvers 127.0.0.1:5370
				refresh 10s
			}
			a gist.github.com 443 {
				resolvers 127.0.0.1:5365
				refresh 10s
			}
		}
		max_fails 2
		fail_duration 10s
		lb_policy random
		header_up Host {http.request.host}

		@has_range {
			header Range *
		}
		header_up @has_range Range {http.request.header.Range}
		@has_if_range {
			header If-Range *
		}
		header_up @has_if_range If-Range {http.request.header.If-Range}

		header_up User-Agent {http.request.header.User-Agent}
		header_up X-Real-IP {http.request.remote.host}
		transport http {
			tls
			tls_insecure_skip_verify
		}
	}
}
