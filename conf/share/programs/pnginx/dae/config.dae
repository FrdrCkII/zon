global {
    log_level: warn
    wan_interface: auto
    dial_mode: domain++
}

dns {
  upstream {
    adg: 'tcp+udp://[::1]:53'
    common: 'tcp+udp://[::1]:5365'
    public: 'tcp+udp://[::1]:5370'
  }
  routing {
    request {
      qname(geosite:cn) -> adg
      qname(geosite:category-ads) -> reject
      qname(geosite:category-ads-all) -> reject
      qname(geosite:geolocation-!cn) -> public
      fallback: adg
    }
    response {
      upstream(public) -> accept
      ip(geoip:private) && !qname(geosite:cn) -> public
      fallback: accept
    }
  }
}

routing {
    pname(NetworkManager, systemd-resolved, dnsmasq) -> must_direct
    pname(smartdns) && l4proto(tcp, udp) && dport(53) -> must_direct
    dport(53) -> must_rules
    
    dip(geoip:private) -> direct
    domain(geosite:category-ads) -> block
    domain(geosite:category-ads-all) -> block
    
    dip(geoip:cn) -> direct
    domain(geosite:cn) -> direct
    
    domain(geosite:geolocation-!cn@cn) -> direct
    # domain(geosite:geolocation-!cn) -> proxy
    # domain(geosite:geolocation-cn@!cn) -> proxy
    domain(geosite:geolocation-cn) -> direct
    
    fallback: direct
}